{
  "name": "team-huddle-app",
  "private": true,
  "version": "1.1.1",
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w @team-huddle/api",
    "dev:web": "npm run dev -w @team-huddle/web",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run migrate -w @team-huddle/api",
    "db:seed": "npm run seed -w @team-huddle/api",
    "db:encrypt-notes": "npm run encrypt-notes -w @team-huddle/api",
    "db:rekey": "npm run rekey -w @team-huddle/api --",
    "mt:sync": "npm run mt:sync -w @team-huddle/api --",
    "lint": "npm run lint -w @team-huddle/api && npm run lint -w @team-huddle/web",
    "build": "npm run lint -w @team-huddle/api && npm run build -w @team-huddle/web",
    "test": "npm test -w @team-huddle/api",
    "typecheck": "npm run typecheck -w @team-huddle/api && npm run typecheck -w @team-huddle/web",
    "desktop:start": "npm --prefix desktop start",
    "desktop:test": "npm --prefix desktop test",
    "desktop:dist": "npm --prefix desktop run dist"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
